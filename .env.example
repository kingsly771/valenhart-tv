# ═══════════════════════════════════════════════════════
#  VALENHART TV v4 — Environment Variables
# ═══════════════════════════════════════════════════════

# Server
PORT=3000

# MongoDB — replace with your Atlas URI or local URI
MONGO_URI=mongodb://localhost:27017/valenhart-tv
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/valenhart-tv

# JWT Secret — change this to a long random string in production!
JWT_SECRET=valenhart-tv-super-secret-change-me-in-production

# JWT expiry
JWT_EXPIRES=7d
