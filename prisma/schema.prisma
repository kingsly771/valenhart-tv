// VALENHART TV — Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  avatar    String   @default("🎭")
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  refreshTokens RefreshToken[]
  favorites     Favorite[]
  history       WatchHistory[]
  passwordResets PasswordReset[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  channelId   String
  channelName String   @default("")
  streamUrl   String   @default("")
  logo        String   @default("")
  grp         String   @default("")
  addedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@map("favorites")
}

model WatchHistory {
  id          String   @id @default(uuid())
  userId      String
  channelId   String
  channelName String   @default("")
  streamUrl   String   @default("")
  logo        String   @default("")
  grp         String   @default("")
  watchedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watch_history")
}

model Playlist {
  id           String   @id @default(uuid())
  name         String
  url          String?
  channelCount Int      @default(0)
  categories   Json     @default("[]")
  isActive     Boolean  @default(true)
  addedById    String?
  createdAt    DateTime @default(now())

  @@map("playlists")
}
